# =============================================================================
# Configuração de ambiente — CÓPIE este arquivo para `.env` e ajuste se preciso.
# Os valores abaixo são as credenciais PÚBLICAS do app demo Swag Labs
# (https://www.saucedemo.com) — app de treinamento, sem dados reais.
# Nunca coloque senhas/dados pessoais reais aqui.
# =============================================================================

# URL base do app alvo
BASE_URL=https://www.saucedemo.com

# Usuários padrão do Swag Labs (públicos, permitem testar cenários distintos)
STANDARD_USER=standard_user
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_USER=performance_glitch_user

# Senha padrão do app demo
PASSWORD=secret_sauce

# Dados de checkout (fictícios)
FIRST_NAME=Jessica
LAST_NAME=Sales
POSTAL_CODE=00000000